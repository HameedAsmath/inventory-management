{
  "compilerOptions": {
    "target": "es2016",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "prisma", "prisma.config.ts", "seed.ts"]
}
